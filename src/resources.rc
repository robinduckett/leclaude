#include <winver.h>

// The badge icon. GetOverlayInfo returns this DLL with the icon index 0.
1 ICON "..\\assets\\leclaude.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Robin Duckett"
            VALUE "FileDescription", "Leclaude overlay handler"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "LeclaudeShell"
            VALUE "LegalCopyright", "Copyright (c) 2026 Robin Duckett. MIT license."
            VALUE "OriginalFilename", "LeclaudeShell.dll"
            VALUE "ProductName", "Leclaude"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
