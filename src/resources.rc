// This file is UTF-8. The pragma tells the resource compiler.
#pragma code_page(65001)

#include <winresrc.h>

#include "resource.h"

// The badge icon. GetOverlayInfo returns this DLL with the icon index 0.
1 ICON "..\\assets\\leclaude.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,3,0
 PRODUCTVERSION 0,1,3,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Robin Duckett"
            VALUE "FileDescription", "Leclaude shell extension"
            VALUE "FileVersion", "0.1.3.0"
            VALUE "InternalName", "LeclaudeShell"
            VALUE "LegalCopyright", "Copyright (c) 2026 Robin Duckett. MIT license."
            VALUE "OriginalFilename", "LeclaudeShell.dll"
            VALUE "ProductName", "Leclaude"
            VALUE "ProductVersion", "0.1.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// The texts of the menu commands. Each LANGUAGE block holds the same four
// IDs. The resource loader selects the block for the UI language of the
// user. The neutral block is English. It serves each language that has no
// block of its own, and thus also the United States and the United Kingdom.

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
STRINGTABLE
BEGIN
    IDS_MENU_TERMINAL "Open Claude Code in Terminal"
    IDS_MENU_POWERSHELL "Open Claude Code in PowerShell"
    IDS_HELP_TERMINAL "Opens Windows Terminal in this folder and starts Claude Code."
    IDS_HELP_POWERSHELL "Opens PowerShell in this folder and starts Claude Code."
END

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN
STRINGTABLE
BEGIN
    IDS_MENU_TERMINAL "Claude Code im Terminal öffnen"
    IDS_MENU_POWERSHELL "Claude Code in PowerShell öffnen"
    IDS_HELP_TERMINAL "Öffnet Windows Terminal in diesem Ordner und startet Claude Code."
    IDS_HELP_POWERSHELL "Öffnet PowerShell in diesem Ordner und startet Claude Code."
END

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH
STRINGTABLE
BEGIN
    IDS_MENU_TERMINAL "Ouvrir Claude Code dans le Terminal"
    IDS_MENU_POWERSHELL "Ouvrir Claude Code dans PowerShell"
    IDS_HELP_TERMINAL "Ouvre Windows Terminal dans ce dossier et démarre Claude Code."
    IDS_HELP_POWERSHELL "Ouvre PowerShell dans ce dossier et démarre Claude Code."
END

LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_MODERN
STRINGTABLE
BEGIN
    IDS_MENU_TERMINAL "Abrir Claude Code en Terminal"
    IDS_MENU_POWERSHELL "Abrir Claude Code en PowerShell"
    IDS_HELP_TERMINAL "Abre Windows Terminal en esta carpeta e inicia Claude Code."
    IDS_HELP_POWERSHELL "Abre PowerShell en esta carpeta e inicia Claude Code."
END

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT
STRINGTABLE
BEGIN
    IDS_MENU_TERMINAL "ターミナルで Claude Code を開く"
    IDS_MENU_POWERSHELL "PowerShell で Claude Code を開く"
    IDS_HELP_TERMINAL "このフォルダーで Windows Terminal を開き、Claude Code を起動します。"
    IDS_HELP_POWERSHELL "このフォルダーで PowerShell を開き、Claude Code を起動します。"
END

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
STRINGTABLE
BEGIN
    IDS_MENU_TERMINAL "在终端中打开 Claude Code"
    IDS_MENU_POWERSHELL "在 PowerShell 中打开 Claude Code"
    IDS_HELP_TERMINAL "在此文件夹中打开 Windows Terminal 并启动 Claude Code。"
    IDS_HELP_POWERSHELL "在此文件夹中打开 PowerShell 并启动 Claude Code。"
END
