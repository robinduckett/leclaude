<!--
  The WiX authoring for the Leclaude MSI package.
  The build gives these defines: AppVersion, DllPath.
  The MSI is for winget and for managed deployment. The MSI writes the
  registration directly. It does not call DllRegisterServer.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?define Clsid = "{AEB0D999-FC8F-4FFA-B160-D4506164F0E7}" ?>

  <Package Name="Leclaude"
           Manufacturer="Robin Duckett"
           Version="$(var.AppVersion)"
           UpgradeCode="{CC9DB183-C148-4F1A-95C0-A229E6DD6711}"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="Leclaude shows a robot badge in Explorer on each folder that has Claude Code session history." />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Leclaude is installed. Remove it first." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="LeclaudeIcon" SourceFile="..\..\assets\leclaude.ico" />
    <Property Id="ARPPRODUCTICON" Value="LeclaudeIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/robinduckett/leclaude" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Leclaude">

        <Component Id="ShellDll">
          <File Id="LeclaudeShellDll" Source="$(var.DllPath)" KeyPath="yes" />

          <!-- The Restart Manager stops Explorer before the file copy and
               starts it again after the installation. This releases the lock
               on the DLL, and the new badge shows without a restart of the
               computer. -->
          <util:RestartResource ProcessName="explorer.exe" />

          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\CLSID\$(var.Clsid)">
            <RegistryValue Type="string" Value="Leclaude overlay handler" />
            <RegistryKey Key="InProcServer32">
              <RegistryValue Type="string" Value="[INSTALLFOLDER]LeclaudeShell.dll" />
              <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
            </RegistryKey>
          </RegistryKey>

          <!-- The key name starts with one space. Windows loads the first 15
               overlay names in alphabetical order. -->
          <RegistryValue Root="HKLM"
                         Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\ Leclaude"
                         Type="string"
                         Value="$(var.Clsid)" />

          <RegistryValue Root="HKLM"
                         Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved"
                         Name="$(var.Clsid)"
                         Type="string"
                         Value="Leclaude overlay handler" />
        </Component>

        <Component Id="LicenseFile">
          <File Source="..\..\LICENSE" />
        </Component>

      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
